{
  "name": "nordlab",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "npm run clean && next dev",
    "dev:fast": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "license:generate": "node scripts/generate-license.mjs",
    "report:downloads": "node scripts/send-download-report.mjs",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.7",
    "next": "^14.2.18",
    "next-intl": "^3.25.0",
    "nodemailer": "^8.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.2"
  }
}
