# === Required: Zoho SMTP (contact form sends here) ===
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=admin@nordlab.net
SMTP_PASS=
# Optional. Must be SMTP_USER or a verified alias in Zoho — omit to use SMTP_USER.
# SMTP_FROM=admin@nordlab.net
SMTP_TO=admin@nordlab.net

# === Optional: Telegram (extra notification channel) ===
# If TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are unset, Telegram is skipped — no error.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Optional: Cloudflare Turnstile (captcha anti-spam) ===
# Without these keys the form still works — honeypot anti-spam only.
# Get keys: https://dash.cloudflare.com → Turnstile → create site → Site Key + Secret Key
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# === License admin API ===
# Protects POST /api/admin/generate-license so you can generate keys remotely
# from home, office, or any trusted machine with the secret.
# Also protects GET/POST /api/admin/download-stats (trial download reports).
LICENSE_ADMIN_SECRET=

# === Download stats (optional) ===
# Trial .apx downloads are logged to data/download-stats.json via /api/downloads/...
# Daily email report (cron): npm run report:downloads
# DOWNLOAD_STATS_MAX_EVENTS=20000

# === CloudPayments (card payments in Russia) ===
# Public ID and API secret from CloudPayments Back Office
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
# Set to 1 to mark orders as test even with a production public ID
# CLOUDPAYMENTS_FORCE_TEST=1

# === Database (PostgreSQL) ===
# Local: docker compose up -d postgres
# MIGRATE_DATABASE_URL=postgresql://nordlab:nordlab_dev@localhost:5434/nordlab
DATABASE_URL=postgresql://nordlab:nordlab_dev@localhost:5434/nordlab
MIGRATE_DATABASE_URL=postgresql://nordlab:nordlab_dev@localhost:5434/nordlab

# === Auth / architect cabinet ===
JWT_SECRET=change_me_to_random_32_chars_min
# HMAC secret for email OTP codes (defaults to JWT_SECRET if unset)
EMAIL_OTP_SECRET=

# === Yandex SmartCaptcha (login/register anti-bot) ===
# https://captcha.yandex.ru/ → create captcha → Server Key + Client Key
SMARTCAPTCHA_SERVER_KEY=
NEXT_PUBLIC_SMARTCAPTCHA_SITEKEY=
# Set to 1 only for local smoke tests without Yandex (never in production)
# SMARTCAPTCHA_FAIL_OPEN=0

# Object billing (registration is free; first object free)
CABINET_OBJECT_PRICE_RUB=2500
CABINET_OBJECT_RENEW_PRICE_RUB=500
CABINET_OBJECT_STORAGE_MONTHS=12
CABINET_OBJECT_READONLY_MONTHS=6
CABINET_OBJECT_DELETE_WARN_DAYS=30
CABINET_OBJECT_STORAGE_GB=10

# Legacy subscription (unused — cabinet access is free)
# CABINET_SUBSCRIPTION_PRICE_RUB=1990
# CABINET_SUBSCRIPTION_DAYS=30

# === Cabinet Object Storage (cloud.ru S3-compatible) ===
# Access Key ID format: <tenant_id>:<key_id>
S3_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET=nordlab
S3_TENANT_ID=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=1
CABINET_MAX_UPLOAD_MB=1000
